# Default text handling

* text=auto

# Python

*.py text eol=lf
*.pyi text eol=lf

# Configuration and documentation

*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Git and shell scripts

*.gitignore text eol=lf
*.gitattributes text eol=lf
*.sh text eol=lf

# Windows scripts

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files

*.pth binary
*.pt binary
*.ckpt binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
